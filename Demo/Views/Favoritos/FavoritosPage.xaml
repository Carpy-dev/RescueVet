<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla: pestaña con lo que el usuario guardó con el corazón. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:models="clr-namespace:Demo.Models"
             x:Class="Demo.Views.Favoritos.FavoritosPage"
             Title="Favoritos"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="18">

            <controls:PageHeader Titulo="Favoritos" MostrarAtras="False"
                                 Subtitulo="Lo que guardaste con el ♡."
                                 Imagen="rv_ilus_vet.png" AnchoImagen="130" />

            <!-- Lista -->
            <VerticalStackLayout x:Name="Lista" Spacing="12" BindableLayout.EmptyView="Todavía no guardaste favoritos.">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemFavoritable">
                        <Border Style="{StaticResource Card}" Padding="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Image Source="{Binding FotoUrl}" WidthRequest="72" HeightRequest="72" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Nombre}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Resumen}" Style="{StaticResource SmallText}" FontSize="13" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="&#xE87D;" Style="{StaticResource Icono}" FontSize="26"
                                       TextColor="{StaticResource Red}" Margin="0,0,6,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFavoritoTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
