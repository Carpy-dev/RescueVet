<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla: recordatorios de la mascota, con botón para agregar y avisos. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:models="clr-namespace:Demo.Models"
             x:Class="Demo.Views.MiMascota.RecordatoriosPage"
             Title="Recordatorios"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

            <controls:PageHeader Titulo="Recordatorios" Subtitulo="Tratamientos y vacunas que se repiten."
                                 Imagen="rv_masc_ic_record.png" AnchoImagen="70" />

            <VerticalStackLayout x:Name="Lista" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Recordatorio">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Image Source="{Binding ImagenUrl}" WidthRequest="56" HeightRequest="52" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" FontFamily="NunitoBold" FontSize="16" />
                                    <Label Text="{Binding Frecuencia}" Style="{StaticResource SmallText}" FontSize="13" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                    <Border Style="{StaticResource Tag}" BackgroundColor="{Binding ColorFondo}" HorizontalOptions="End">
                                        <Label Text="{Binding Falta}" Style="{StaticResource TagText}" TextColor="{Binding ColorTexto}" />
                                    </Border>
                                    <Label Text="{Binding FechaTexto}" Style="{StaticResource SmallText}" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Agregar recordatorio" Style="{StaticResource PrimaryButton}" Clicked="OnAgregarClicked" />

            <!-- Avisos -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Avisos" Style="{StaticResource SectionTitle}" FontSize="17" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Notificaciones" FontFamily="NunitoBold" FontSize="15" />
                            <Label Text="Recibir un aviso el día anterior" Style="{StaticResource SmallText}" FontSize="13" />
                        </VerticalStackLayout>
                        <Switch InputTransparent="True" Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Resumen semanal" FontFamily="NunitoBold" FontSize="15" />
                            <Label Text="Lunes por la mañana" Style="{StaticResource SmallText}" FontSize="13" />
                        </VerticalStackLayout>
                        <Switch InputTransparent="True" Grid.Column="1" OnColor="{StaticResource Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
