<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla: perfil, preferencias, ayuda y cierre de sesión. Las preferencias son visuales por ahora. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             x:Class="Demo.Views.Inicio.ConfiguracionPage"
             Title="Configuración"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

            <controls:PageHeader x:Name="Cabecera" Titulo="Configuración" Insignia="" Subtitulo="Tu cuenta y preferencias."
                                 Imagen="rv_home_config.png" AnchoImagen="70" />

            <!-- Perfil -->
            <Border Style="{StaticResource Banner}" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 32"
                            BackgroundColor="{StaticResource Surface}">
                        <Image Source="rv_home_avatar.png" WidthRequest="58" HeightRequest="58" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label x:Name="NombreLabel" Style="{StaticResource CardTitle}" FontSize="18" />
                        <Label x:Name="CorreoLabel" Style="{StaticResource SmallText}" FontSize="13" />
                        <Border Style="{StaticResource Tag}" BackgroundColor="{StaticResource Surface}" Margin="0,6,0,0">
                            <Label x:Name="TipoLabel" Style="{StaticResource TagText}" TextColor="{StaticResource Primary}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Cuenta -->
            <Label x:Name="TituloCuenta" Text="Cuenta" Style="{StaticResource SectionTitle}" FontSize="16" Margin="4,0,0,-8" />
            <Border x:Name="SeccionCuenta" Style="{StaticResource Card}" Padding="16,4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnMiMascotaTapped" /></Grid.GestureRecognizers>
                        <Label Text="&#xE91D;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Primary}" />
                        <Label Grid.Column="1" Text="Mis mascotas" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&#xE5CC;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Muted}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Preferencias -->
            <Label Text="Preferencias" Style="{StaticResource SectionTitle}" FontSize="16" Margin="4,0,0,-8" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,8">
                        <Label Text="&#xE7F4;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Amber}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Notificaciones" FontFamily="NunitoBold" FontSize="15" />
                            <Label Text="Recordatorios y casos cercanos" Style="{StaticResource SmallText}" />
                        </VerticalStackLayout>
                        <Switch InputTransparent="True" Grid.Column="2" IsToggled="True" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,8">
                        <Label Text="&#xE002;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Red}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Alertas de emergencia" FontFamily="NunitoBold" FontSize="15" />
                            <Label Text="Animales en peligro a menos de 5 km" Style="{StaticResource SmallText}" />
                        </VerticalStackLayout>
                        <Switch InputTransparent="True" Grid.Column="2" IsToggled="True" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,8">
                        <Label Text="&#xE55F;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Green}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Usar mi ubicación" FontFamily="NunitoBold" FontSize="15" />
                            <Label Text="Para mostrar lo más cercano" Style="{StaticResource SmallText}" />
                        </VerticalStackLayout>
                        <Switch InputTransparent="True" Grid.Column="2" OnColor="{StaticResource Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Ayuda -->
            <Label Text="Ayuda" Style="{StaticResource SectionTitle}" FontSize="16" Margin="4,0,0,-8" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <VerticalStackLayout>
                    <Grid x:Name="FilaCentroAyuda" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCentroAyudaTapped" /></Grid.GestureRecognizers>
                        <Label Text="&#xE887;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Blue}" />
                        <Label Grid.Column="1" Text="Centro de ayuda" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&#xE5CC;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Muted}" />
                    </Grid>
                    <BoxView x:Name="LineaCentroAyuda" HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,12">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnTerminosTapped" /></Grid.GestureRecognizers>
                        <Label Text="&#xE9E0;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Blue}" />
                        <Label Grid.Column="1" Text="Términos y privacidad" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&#xE5CC;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Muted}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Cerrar sesión" Style="{StaticResource PrimaryButton}"
                    BackgroundColor="{StaticResource RedBg}" TextColor="{StaticResource Red}"
                    Clicked="OnCerrarSesionClicked">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE9BA;" FontFamily="MaterialIcons" Color="{StaticResource Red}" Size="22" />
                </Button.ImageSource>
            </Button>

            <Label Text="RescueVet · versión 1.0" Style="{StaticResource SmallText}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
