<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla: formulario para pedir ayuda, con datos del animal, foto, ubicación y WhatsApp. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             x:Class="Demo.Views.Casos.ReportarCasoPage"
             Title="Reportar caso"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

            <controls:PageHeader x:Name="Cabecera" Titulo="Reportar caso"
                                 Subtitulo="Contanos qué pasó y publicamos tu pedido de ayuda."
                                 Imagen="rv_ilus_casos.png" AnchoImagen="130" />

            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Animal" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource CajaCampo}">
                        <Entry x:Name="NombreEntry" Placeholder="Nombre o descripción del animal" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="16">
                        <Label Text="Especie" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="Prioridad" Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="1" Style="{StaticResource CajaCampo}">
                            <Picker x:Name="EspeciePicker" Title="Elegir">
                                <Picker.Items>
                                    <x:String>Perro</x:String>
                                    <x:String>Gato</x:String>
                                    <x:String>Otro</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CajaCampo}">
                            <Picker x:Name="PrioridadPicker" Title="Elegir">
                                <Picker.Items>
                                    <x:String>Urgente</x:String>
                                    <x:String>Alta</x:String>
                                    <x:String>Normal</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </Grid>

                    <Label Text="¿Qué le pasa?" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource CajaCampo}">
                        <Editor x:Name="DescripcionEditor" HeightRequest="110"
                                Placeholder="Contanos qué le pasa al animal y qué ayuda necesita" />
                    </Border>

                    <Label Text="Ubicación" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource CajaCampo}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="&#xE55F;" Style="{StaticResource IconoCampo}" />
                            <Entry x:Name="UbicacionEntry" Grid.Column="1" Placeholder="Dirección o referencia" />
                        </Grid>
                    </Border>

                    <Label Text="Foto del animal" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="MarcoFoto" StrokeThickness="0" StrokeShape="RoundRectangle 16" IsVisible="False">
                        <Image x:Name="FotoPreview" HeightRequest="200" Aspect="AspectFill" />
                    </Border>
                    <Button x:Name="BotonFoto" Text="Subir foto" BackgroundColor="{StaticResource PrimarySoft}"
                            TextColor="{StaticResource Primary}" Clicked="OnSubirFotoClicked" />

                    <Label Text="Tu WhatsApp" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource CajaCampo}">
                        <Entry x:Name="TelefonoEntry" Placeholder="Ej. 3704 123456" Keyboard="Telephone" />
                    </Border>

                    <Button Text="Enviar solicitud" Style="{StaticResource PrimaryButton}"
                            BackgroundColor="{StaticResource Red}" Clicked="OnEnviarSolicitudClicked" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Banner}" BackgroundColor="{StaticResource RedBg}" Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="&#xE88E;" Style="{StaticResource Icono}" FontSize="24" TextColor="{StaticResource Red}" VerticalOptions="Start" />
                    <Label Grid.Column="1" Style="{StaticResource CardDesc}" TextColor="{StaticResource TextDark}"
                           Text="Si el animal está herido, mantené distancia y no le des comida ni agua hasta que llegue la ayuda." />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
