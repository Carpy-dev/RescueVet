<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla: perfil de una veterinaria, con sus servicios, precios y datos de contacto. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Demo.Controls"
             xmlns:models="clr-namespace:Demo.Models"
             x:Class="Demo.Views.Veterinarias.VeterinariaDetallePage"
             x:DataType="models:Veterinaria"
             Title="Veterinaria"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView>
            <Grid RowDefinitions="Auto,Auto">

                <!-- ===== Foto principal ===== -->
                <Grid HeightRequest="270">
                    <Image Source="{Binding FotoUrl}" Aspect="AspectFill" />
                    <controls:BotonAtras Margin="20,16,0,0" />
                    <Border Style="{StaticResource HeartCircle}" WidthRequest="46" HeightRequest="46"
                            StrokeShape="RoundRectangle 23" Margin="0,16,20,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoritoTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="&#xE87E;" Style="{StaticResource Icono}" FontSize="26" TextColor="{StaticResource TextDark}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding EsFavorito}" Value="True">
                                    <Setter Property="Text" Value="&#xE87D;" />
                                    <Setter Property="TextColor" Value="{StaticResource Red}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <!-- ===== Hoja con la información ===== -->
                <Border Grid.Row="1" BackgroundColor="{StaticResource Bg}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 28,28,0,0" Margin="0,-30,0,0" Padding="20,0,20,24">
                    <VerticalStackLayout Spacing="18">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <BoxView WidthRequest="76" Color="Transparent" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="0,14,0,0">
                                <Label Text="{Binding Nombre}" Style="{StaticResource PageTitle}" FontSize="24" />
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="&#xE838;" FontFamily="MaterialIcons" FontSize="16" TextColor="{StaticResource Star}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding PuntajeTexto}" FontFamily="NunitoBold" FontSize="14" TextColor="{StaticResource Star}" />
                                            <Span Text="  ·  " TextColor="{StaticResource Muted}" />
                                            <Span Text="{Binding ResenasLargo}" FontSize="13" TextColor="{StaticResource Muted}" />
                                            <Span Text="  ·  " TextColor="{StaticResource Muted}" />
                                            <Span Text="{Binding Distancia}" FontSize="13" TextColor="{StaticResource Muted}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Etiquetas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Etiqueta">
                                    <Border Style="{StaticResource Tag}" BackgroundColor="{Binding ColorFondo}">
                                        <Label Text="{Binding Texto}" Style="{StaticResource TagText}" TextColor="{Binding ColorTexto}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <!-- Atención 24 h -->
                        <Border Style="{StaticResource Banner}" BackgroundColor="{StaticResource RedBg}" Padding="14" IsVisible="{Binding Abierta24h}">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="&#xE8B5;" Style="{StaticResource Icono}" FontSize="22" TextColor="{StaticResource Red}" />
                                <Label Text="Guardia permanente: atienden urgencias las 24 horas." FontFamily="NunitoBold" FontSize="14"
                                       TextColor="{StaticResource Red}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Sobre la clínica -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Sobre la clínica" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding SobreNosotros}" Style="{StaticResource CardDesc}" FontSize="15" />
                        </VerticalStackLayout>

                        <!-- Servicios y precios -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Servicios y precios" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,6">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Servicios}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:Servicio">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12">
                                                <Label Text="&#xE86C;" Style="{StaticResource Icono}" FontSize="20" TextColor="{StaticResource Green}" />
                                                <Label Grid.Column="1" Text="{Binding Nombre}" FontFamily="NunitoBold" FontSize="15" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding Precio}" FontFamily="NunitoExtraBold" FontSize="15"
                                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                            <Label Text="Precios de referencia. Pueden variar según el caso." Style="{StaticResource SmallText}" />
                        </VerticalStackLayout>

                        <!-- Contacto -->
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="14">
                                <controls:FilaInfo Glifo="&#xE55F;" Titulo="Dirección" Valor="{Binding Direccion}" Color="{StaticResource Primary}" />
                                <controls:FilaInfo Glifo="&#xE8B5;" Titulo="Horario de atención" Valor="{Binding Horario}" Color="{StaticResource Green}" />
                                <controls:FilaInfo Glifo="&#xE0CD;" Titulo="Teléfono" Valor="{Binding Telefono}" Color="{StaticResource Blue}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Ícono redondo superpuesto entre la foto y la hoja (va al final para quedar encima) -->
                <Image Grid.Row="1" Source="{Binding IconoUrl}" WidthRequest="76" HeightRequest="76"
                       HorizontalOptions="Start" VerticalOptions="Start" Margin="20,-58,0,0" />
            </Grid>
        </ScrollView>

        <!-- ===== Acciones fijas abajo ===== -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource Surface}" StrokeThickness="0"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14">
            <Border.Shadow>
                <Shadow Brush="#0A2040" Opacity="0.08" Radius="16" Offset="0,-4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="&#xE52E;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="54" HeightRequest="50" Padding="0"
                        BackgroundColor="{StaticResource PrimarySoft}" TextColor="{StaticResource Primary}"
                        Clicked="OnComoLlegarClicked" SemanticProperties.Description="Cómo llegar" />
                <Button Grid.Column="1" Text="Favorito" Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{StaticResource PrimarySoft}" TextColor="{StaticResource Primary}"
                        Clicked="OnFavoritoTapped">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding EsFavorito}" Value="True">
                            <Setter Property="Text" Value="Quitar" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <ImageButton Grid.Column="2" Source="rv_whatsapp.png" BackgroundColor="#25D366" WidthRequest="54" HeightRequest="54" CornerRadius="27" Padding="12"
                             VerticalOptions="Center" Clicked="OnContactarClicked" SemanticProperties.Description="Contactar por WhatsApp" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
